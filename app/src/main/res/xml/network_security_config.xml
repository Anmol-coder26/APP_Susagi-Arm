<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Production / Release Policy: Strict HTTPS enforcement with zero cleartext traffic permitted -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
